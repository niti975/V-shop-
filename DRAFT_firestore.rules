rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny Catch-all)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Reusable Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isEmailVerified() && (
        request.auth.token.email == "kumarinitish98569@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validation Blueprints ---

    // User entity validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'handle', 'displayName', 'createdAt']) &&
             data.keys().size() == 4 &&
             data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid &&
             data.handle is string && data.handle.size() >= 2 && data.handle.size() <= 30 && data.handle.matches('^@[a-zA-Z0-9_\\-]+$') &&
             data.displayName is string && data.displayName.size() <= 50;
    }

    // Seller entity validation
    function isValidSeller(data) {
      return data.keys().hasAll(['uid', 'kycStatus', 'verifyStatus']) &&
             (data.keys().size() == 3 || (data.keys().size() == 4 && data.keys().hasAll(['kycVerifiedAt']))) &&
             data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid &&
             data.kycStatus is string && data.kycStatus in ['None', 'Pending', 'Approved', 'Rejected'] &&
             data.verifyStatus is string && data.verifyStatus in ['None', 'Blue', 'Purple', 'Green'];
    }

    // Shop entity validation
    function isValidShop(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'shopName', 'category', 'isLocked', 'catalogCount', 'createdAt']) &&
             (data.keys().size() == 7 || (data.keys().size() == 8 && data.keys().hasAll(['updatedAt']))) &&
             data.id is string && data.id.size() <= 128 &&
             data.ownerUid is string && data.ownerUid.size() <= 128 && data.ownerUid == request.auth.uid &&
             data.shopName is string && data.shopName.size() >= 2 && data.shopName.size() <= 80 &&
             data.category is string && data.category in ['Ethnic Apparel', 'Traditions Wear', 'Modern Apparel', 'Handlooms Handicraft'] &&
             data.isLocked is bool &&
             data.catalogCount is int && data.catalogCount >= 0;
    }

    // --- Collections Routing Rules ---

    // MATCH USERS COLLECTION
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || resource.data.handle != null);
      
      allow create: if isEmailVerified() && isValidId(userId) && userId == request.auth.uid &&
                       isValidUser(incoming()) && incoming().createdAt == request.time;
                       
      allow update: if isEmailVerified() && isValidId(userId) && userId == request.auth.uid &&
                       isValidUser(incoming()) && incoming().createdAt == existing().createdAt;
                       
      allow delete: if isAdmin() || (isEmailVerified() && userId == request.auth.uid);
    }

    // MATCH SELLERS COLLECTION (KYC / VERIFICATION RATINGS)
    match /sellers/{sellerId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || resource.data.verifyStatus != 'None');
      
      // Creating standard seller record reserves status fields to default 'None'/'Pending' for standard users
      allow create: if isEmailVerified() && isValidId(sellerId) && sellerId == request.auth.uid &&
                       isValidSeller(incoming()) && 
                       (isAdmin() || (incoming().kycStatus in ['None', 'Pending'] && incoming().verifyStatus == 'None'));
                       
      // Normal update: Only Admin can approve KYC / verify badge. Standard user can only trigger a pending submission.
      allow update: if isEmailVerified() && isValidId(sellerId) && sellerId == request.auth.uid &&
                       isValidSeller(incoming()) && (
                         isAdmin() || (
                           // Action: Submit KYC for review
                           incoming().verifyStatus == existing().verifyStatus &&
                           existing().kycStatus in ['None', 'Pending'] &&
                           incoming().kycStatus == 'Pending' &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['kycStatus'])
                         )
                       );
                       
      allow delete: if isAdmin();
    }

    // MATCH SHOPS COLLECTION (WITH INTEGRATED CATEGORY LOCKS & OVERRIDES)
    match /shops/{shopId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.isLocked == true || resource.data.verifyStatus != 'None');
      
      allow create: if isEmailVerified() && isValidId(shopId) && 
                       isValidShop(incoming()) && incoming().createdAt == request.time &&
                       incoming().catalogCount == 0 &&
                       (!incoming().isLocked); // Cannot start pre-locked unless manually approved
                       
      // Dynamic Lock/Unlock Action-Based updates
      allow update: if isEmailVerified() && isValidId(shopId) && 
                       isValidShop(incoming()) && 
                       (
                         isAdmin() || (
                           incoming().ownerUid == existing().ownerUid &&
                           incoming().createdAt == existing().createdAt &&
                           (
                             // Action 1: When unlocked, modifying details
                             (!existing().isLocked && 
                              incoming().updatedAt == request.time &&
                              incoming().diff(existing()).affectedKeys().hasOnly(['shopName', 'category', 'isLocked', 'catalogCount', 'updatedAt'])) ||
                             
                             // Action 2: When locked, changes restricted to catalog additions, toggling isLocked or updating the timestamp
                             (existing().isLocked && 
                              incoming().updatedAt == request.time &&
                              incoming().diff(existing()).affectedKeys().hasOnly(['isLocked', 'catalogCount', 'updatedAt']))
                           )
                         )
                       );
                       
      allow delete: if isAdmin() || (isEmailVerified() && resource.data.ownerUid == request.auth.uid && !resource.data.isLocked);
    }
  }
}
